FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
DATABASE_URL=postgresql://user:password@db:5432/gamedev_platform
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=your-email@example.com

# SMS Configuration
SMS_PROVIDER=
SMS_API_KEY=
SMS_SECRET=
SMS_SENDER=

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:5000/api/auth/oauth/github/callback

# QQ OAuth Configuration
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key
QQ_REDIRECT_URI=http://localhost:5000/api/auth/oauth/qq/callback

# Email Verification Configuration
EMAIL_VERIFICATION_CODE_EXPIRES=300
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASSWORD=your-email-password
EMAIL_SENDER=your-email@example.com

# OAuth State Timeout (seconds)
OAUTH_STATE_TIMEOUT=600

